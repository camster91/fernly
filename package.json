{
  "name": "fernly-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.10",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.18.2",
    "expo": "~57.0.7",
    "expo-haptics": "~57.0.1",
    "expo-localization": "^57.0.1",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.86.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:crisis": "tsx scripts/test-crisis.mjs && tsx scripts/test-crisis-edge-cases.mjs",
    "test:unit": "vitest run",
    "test": "npm run test:crisis && npm run test:unit",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test"
